{
  "name": "asrbox",
  "version": "0.1.8",
  "private": true,
  "workspaces": [
    "app",
    "web",
    "tauri"
  ],
  "scripts": {
    "dev:web": "cd web && vite --host 127.0.0.1 --port 5173",
    "dev:server": ".venv/bin/uvicorn backend.main:app --reload --port 17494",
    "dev:desktop": "bun run setup:dev && bun run --cwd tauri dev",
    "setup:dev": "node scripts/setup-dev-sidecar.js",
    "build:web": "cd web && vite build",
    "build:docker": "docker compose build",
    "test:docker": "./scripts/test-docker.sh",
    "test:e2e:docker": "playwright test app/e2e/docker-smoke.spec.ts --config=playwright.docker.config.ts",
    "build:desktop": "./scripts/build-server.sh && bun run --cwd tauri build",
    "audit:frontend": "node scripts/frontend-quality-audit.mjs",
    "audit:dependencies": "./scripts/audit-dependencies.sh",
    "verify:third-party": "./scripts/verify-third-party.sh",
    "check:versions": "node scripts/check-versions.mjs",
    "test:release-tools": "node --test scripts/*.test.mjs",
    "verify:release-assets": "./scripts/verify-release-assets.sh",
    "test:e2e:smoke": "playwright test app/e2e/public-beta-smoke.spec.ts",
    "test:e2e:llm": "playwright test app/e2e/llm-proofreading.spec.ts",
    "test:e2e:about": "playwright test app/e2e/about-updates.spec.ts",
    "test:e2e:maintained": "playwright test app/e2e/public-beta-smoke.spec.ts app/e2e/llm-proofreading.spec.ts app/e2e/llm-translation.spec.ts app/e2e/about-updates.spec.ts app/e2e/model-storage-settings.spec.ts app/e2e/models-download-controls.spec.ts app/e2e/transcript-editing.spec.ts app/e2e/chat.spec.ts",
    "test:frontend:unit": "bun test app/src",
    "check:open-source": "./scripts/check-open-source-readiness.sh",
    "typecheck": "tsc -p app/tsconfig.json --noEmit && cd web && tsc --noEmit",
    "test:backend": ".venv/bin/python -m pytest backend/tests -q --ignore=backend/tests/test_binary_smoke.py",
    "test:backend:real-models": "ASRBOX_RUN_REAL_MODELS=1 .venv/bin/python -m pytest backend/real_tests -q",
    "test:backend:real-models:full": "ASRBOX_RUN_REAL_MODELS=1 .venv/bin/python -m pytest backend/real_tests -q",
    "test:backend:model-benchmark-full": ".venv/bin/python -m pytest backend/tests -q -k benchmark",
    "test:backend:long-audio": ".venv/bin/python -m pytest backend/tests -q -k long_audio",
    "test:backend:providers": ".venv/bin/python -m pytest backend/tests -q -k provider",
    "test:backend:storage-security": ".venv/bin/python -m pytest backend/tests -q -k 'storage or restore or backup'",
    "test:backend:server": ".venv/bin/python -m pytest backend/tests -q -k 'server or runtime'",
    "test:backend:contract": ".venv/bin/python -m pytest backend/tests/test_contract.py -q",
    "test:backend:binary-smoke": "ASRBOX_BINARY_SMOKE=1 .venv/bin/python -m pytest backend/tests/test_binary_smoke.py -q",
    "test:backend:95": ".venv/bin/python -m compileall backend && npm run test:backend && npm run typecheck && npm run build:web && npm run test:backend:providers && npm run test:backend:storage-security && npm run test:backend:server && npm run test:backend:long-audio && npm run test:backend:contract && npm run test:backend:binary-smoke && npm run test:backend:real-models:full",
    "test:backend:all": "npm run test:backend && npm run test:backend:real-models && npm run test:backend:model-benchmark-full && npm run test:backend:long-audio && npm run test:backend:providers && npm run test:backend:storage-security && npm run test:backend:server"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0"
  },
  "packageManager": "bun@1.3.8",
  "dependencies": {
    "postcss": "^8.5.23"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "nanoid": "3.3.18"
  }
}
