# Copy to .env before running Docker Compose. Defaults keep ASRbox host-local.
ASRBOX_IMAGE=asrbox:local
ASRBOX_VERSION=0.3.3
ASRBOX_BIND_ADDRESS=127.0.0.1
ASRBOX_PORT=17494
ASRBOX_DATA_VOLUME=asrbox-data

# Required when ASRBOX_BIND_ADDRESS is not loopback. Generate with:
# openssl rand -hex 32
ASRBOX_API_TOKEN=

# Optional host paths for bind mounts in compose.yaml (unset means named volume only).
# Model storage mount: ASRBOX_MODEL_STORAGE_HOST_PATH=/Volumes/<drive>/asrbox-models
# Ingested-media mount (recommend an external drive on macOS or D: on Windows):
# ASRBOX_UPLOADS_HOST_PATH=/Volumes/<drive>/asrbox-uploads
# ASRBOX_UPLOADS_HOST_PATH=D:/asrbox-uploads
