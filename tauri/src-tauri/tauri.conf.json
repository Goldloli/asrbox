{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ASRbox",
  "version": "0.1.0",
  "identifier": "com.goldloli.asrbox",
  "build": {
    "beforeDevCommand": "cd .. && bun run dev:web",
    "beforeBuildCommand": "cd .. && bun run build:web",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "capabilities": ["default"]
    },
    "windows": [
      {
        "title": "ASRbox",
        "width": 1280,
        "height": 820,
        "center": true,
        "minWidth": 960,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["binaries/asrbox-server", "binaries/ffmpeg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": ".*"
    }
  }
}
